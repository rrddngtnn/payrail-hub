# CHATUPI configuration — copy to .env and fill in real values.
# NEVER commit .env with real secrets.

# --- Auth (generate: python -c "from api_python.security import hash_password; print(hash_password('yourpass'))" ---
CHATUPI_SECRET_KEY=            # random ≥48 chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
CHATUPI_PASSWORD_HASH=         # pbkdf2_sha256$... format
CHATUPI_BASE_PATH=/CHATUPI
CHATUPI_DATABASE=              # SQLite path; default: data/chatupi.sqlite3 (relative to repo)
CHATUPI_RETENTION_DAYS=30
CHATUPI_HOURLY_LIMIT=10
CHATUPI_ALLOWED_HOSTS=localhost,127.0.0.1
CHATUPI_ALLOW_HTTP=0           # 1 only for local dev

# Project root for run-output cleanup; default: repo root (relative resolution)
VERIFY_APP_ROOT=

# --- UPI extraction proxies (required) ---
# India residential exit for ChatGPT checkout + Stripe UPI
UPI_LINK_PROXY=
# Vietnam residential exit for promo campaign application (dedicated; NOT falling back to India)
UPI_LINK_PROMOTION_PROXY=

# --- Optional: India billing identity override (autofill from identity.py by default) ---
# UPI_BILLING_NAME=Raj Kumar
# UPI_BILLING_LINE1=123 MG Road
# UPI_BILLING_CITY=Mumbai
# UPI_BILLING_STATE=MH
# UPI_BILLING_POSTAL=400001
