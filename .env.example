# PayRail Hub configuration — copy to .env and fill in real values.
# NEVER commit .env with real secrets.
#
# All settings use the PAYRAIL_* namespace (per-rail proxy vars also supported).

# --- Auth (generate: python -c "from api_python.security import hash_password; print(hash_password('yourpass'))" ---
PAYRAIL_SECRET_KEY=            # random ≥48 chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
PAYRAIL_PASSWORD_HASH=         # pbkdf2_sha256$... format
PAYRAIL_BASE_PATH=/payrail
PAYRAIL_DATABASE=              # SQLite path; default: data/payrail.sqlite3 (relative to repo)
PAYRAIL_RETENTION_DAYS=30
PAYRAIL_HOURLY_LIMIT=10
PAYRAIL_ALLOWED_HOSTS=localhost,127.0.0.1
PAYRAIL_ALLOW_HTTP=0           # 1 only for local dev

# Project root for run-output cleanup; default: repo root (relative resolution)
VERIFY_APP_ROOT=

# --- Proxies ---
# Shared region-rewritable base proxy (supports __cr.<cc>, cr.<cc>, region-<CC>)
PAYRAIL_PROXY=
# Dedicated promotion proxy (required for promo-handoff rails like UPI)
PAYRAIL_PROMOTION_PROXY=

# Or per-rail overrides (take precedence over PAYRAIL_PROXY):
UPI_LINK_PROXY=
UPI_LINK_PROMOTION_PROXY=
# IDEAL_LINK_PROXY=
# PIX_LINK_PROXY=
# GOPAY_LINK_PROXY=
# MOMO_LINK_PROXY=
# PAYRAIL_PROXY_UPI=
# PAYRAIL_PROXY_IDEAL=

# --- Optional: Engine & policy overrides ---
# PAYRAIL_PLAN_NAME=chatgptplusplan
# PAYRAIL_AMOUNT_MAX=50000
# PAYRAIL_AMOUNT_MAX_UPI=50000
# PAYRAIL_PROMO_UPI=plus-1-month-free
# PAYRAIL_PROMO_REGION_UPI=VN
# PAYRAIL_CHATGPT_CLIENT_VERSION=
# PAYRAIL_CHATGPT_CLIENT_BUILD=
# PAYRAIL_STRIPE_VERSION=
# PAYRAIL_STRIPE_RUNTIME_VERSION=

# --- Optional: Per-rail billing identity override (autofilled per locale by default) ---
# Prefixes: UPI_BILLING_, IDEAL_BILLING_, PIX_BILLING_, GOPAY_BILLING_, MOMO_BILLING_
# UPI_BILLING_NAME=...
# UPI_BILLING_LINE1=...
# UPI_BILLING_CITY=...
# UPI_BILLING_STATE=...
# UPI_BILLING_POSTAL=...
